# ─────────────────────────────────────────────────────────────────────────────
# Oracle Trader Assist — Environment Configuration
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
ENVIRONMENT=development          # development | production | test
DEBUG=true
LOG_LEVEL=DEBUG                  # DEBUG | INFO | WARNING | ERROR
LOG_SERIALIZE=false              # true in production (JSON logs)

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=oracle
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=oracle_db

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=                # Set if Redis has auth enabled

# ── Claude AI ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_OPUS_MODEL=claude-opus-4-7
CLAUDE_MAX_TOKENS=8096

# ── Context Window ────────────────────────────────────────────────────────────
MAX_CONTEXT_TOKENS=150000
HISTORY_BUDGET_TOKENS=80000

# ── WebSocket ─────────────────────────────────────────────────────────────────
WS_HEARTBEAT_INTERVAL=30        # seconds between ping/pong
WS_MAX_CONNECTIONS=100

# ── External Data APIs ────────────────────────────────────────────────────────
NEWS_API_KEY=                       # newsapi.org — leave blank to skip news context
FINNHUB_API_KEY=                    # finnhub.io  — leave blank to skip calendar context

# ── Telegram Notifications ────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=                 # From @BotFather — leave blank to disable
TELEGRAM_CHAT_ID=                   # Your chat ID or group ID

# ── Scheduler ─────────────────────────────────────────────────────────────────
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=America/Sao_Paulo
BRIEFING_ASSETS=PETR4,VALE3,WINFUT,WDOFUT

# ── MetaTrader5 (Windows-only — leave blank to use MockMarketAdapter) ────────
MT5_PATH=
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# ── CORS (comma-separated origins for production) ─────────────────────────────
# ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
